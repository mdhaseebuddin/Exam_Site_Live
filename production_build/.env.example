# =============================================================================
# Exam Platform — Production Environment Template
# =============================================================================
# COPY this file to `.env` (in production_build/) for local development, OR set
# each variable directly in your cloud host's environment dashboard. The app
# reads them via python-dotenv (load_dotenv()) at startup; every variable below
# maps 1:1 to an os.environ.get() in app.py. NEVER commit the real `.env`.
#
# Generate a strong secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# --- Flask core -------------------------------------------------------------
FLASK_ENV="production"
SECRET_KEY="CHANGE_ME_generate_a_random_64_char_hex_key"
SESSION_COOKIE_SECURE="true"     # must be "true" when serving over HTTPS

# --- Email - Brevo Transactional Email API (OTP delivery) --------------------
# OTPs are sent through Brevo's REST API via `sib_api_v3_sdk` — NOT Gmail SMTP.
# The legacy SMTP_* variables are NOT read by the code and can be removed.
# Two fully-isolated channels, each with its OWN Brevo API key / sender:
#
#   HOST channel    -> BREVO_HOST_API_KEY        + MAIL_DEFAULT_SENDER
#   STUDENT channel -> BREVO_STUDENT_API_KEY_1/_2 + MAIL_STUDENT_SENDER
#
# Generate the keys here: https://app.brevo.com/ -> SMTP & API -> API Keys
# Verify the sender here: https://app.brevo.com/ -> Senders & IP
# (The sender email/domain MUST be verified on the SAME account the key was
# created in; unverified or freemail senders are rejected with HTTP 400
# "Sender not verified" — check the `otp_email_failed` audit lines.)

# HOST channel (password reset / host login OTPs) — verified on the
# BREVO_HOST_API_KEY account.
BREVO_HOST_API_KEY="xkeysib-REPLACE_WITH_HOST_API_KEY"

# STUDENT channel (student registration OTPs). KEY_1 is tried first; if the
# call fails (exception OR missing messageId) the code fails over to KEY_2.
# Setting just KEY_1 is fine.
BREVO_STUDENT_API_KEY_1="xkeysib-REPLACE_WITH_STUDENT_API_KEY_1"
BREVO_STUDENT_API_KEY_2="xkeysib-REPLACE_WITH_STUDENT_API_KEY_2"

# Sender address the HOST key is verified with.
MAIL_DEFAULT_SENDER="mdhaseebuddin77@gmail.com"

# STUDENT channel (student registration OTPs) — MUST be a sender verified on
# the BREVO_STUDENT_API_KEY_1/_2 accounts. Reusing the host sender here makes
# Brevo drop the emails (unverified sender / freemail-domain block).
MAIL_STUDENT_SENDER="velotest2026@gmail.com"

# --- Database ----------------------------------------------------------------
# By default the app uses a SQLite file. Resolution order:
#   1. DATABASE_URL  -> used verbatim if set (e.g. managed external DB)
#   2. DB_PATH       -> explicit absolute path to the SQLite file
#   3. RENDER_PERSISTENT_DISK_PATH -> set automatically when a Render
#      Persistent Disk is attached (recommended — see below)
#   4. production_build/instance/exam.db (created automatically at startup)
#
# >>> RENDER / cloud persistence (IMPORTANT) <<<
# On free-tier / cloud instances the filesystem is EPHEMERAL and is wiped on
# every redeploy. If the SQLite DB lives in instance/ (the default on a plain
# deploy), registered host accounts and student submissions VANISH on each
# deploy, forcing everyone to re-register. To keep data across redeploys:
#   * Render: add a Persistent Disk to the service, and set:
#       RENDER_PERSISTENT_DISK_PATH=<the mount path Render provides>   (e.g. /opt/persistent)
#     The app will then store its SQLite file at <disk>/exam.db.
#   * Or: point DB_PATH at a persistent, absolute location you control.
#
# To use a hosted Postgres/MySQL DB instead, uncomment and set:
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"
# NOTE: this app ships SQLite/WAL-dialect SQL, so SQLite is the default and
# recommended engine.
#

# --- Optional tuning (safe to leave commented out; defaults listed) ----------
# DB_PATH                 # absolute path to the SQLite file (default: instance/exam.db)
# RENDER_PERSISTENT_DISK_PATH  # set by Render when a Persistent Disk is attached
# LOG_FILE                # absolute path to the log file (default: logs/exam.log)
# MAX_SUBMISSIONS=500     # hard cap on total completed exam submissions
# DAILY_REGISTRATION_LIMIT=70  # strict max student registrations per host per 24h (across all links)
# DAILY_REGISTRATION_WINDOW_HOURS=24  # rolling window (hours) that defines a host's "day"
# MAX_CONTENT_LENGTH=1048576   # max request-body bytes (1 MiB default)
# WTF_CSRF_TIME_LIMIT=21600    # CSRF-token lifetime in seconds (6 h default)


