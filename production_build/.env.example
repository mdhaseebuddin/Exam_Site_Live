# =============================================================================
# Exam Platform — Production Environment Template
# =============================================================================
# COPY this file to `.env` (in production_build/) for local development, OR set
# each variable directly in your cloud host's environment dashboard. The app
# reads them via python-dotenv (load_dotenv()) at startup; every variable below
# maps 1:1 to an os.environ.get() in app.py. NEVER commit the real `.env`.
#
# Generate a strong secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# --- Flask core -------------------------------------------------------------
FLASK_ENV="production"
SECRET_KEY="CHANGE_ME_generate_a_random_64_char_hex_key"
SESSION_COOKIE_SECURE="true"     # must be "true" when serving over HTTPS

# --- Email / SMTP (password-reset OTP delivery) ------------------------------
# For Gmail, use an App Password (Google Account -> Security -> 2-Step
# Verification -> App passwords) — NOT your normal account password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="replace_with_real@gmail.com"
SMTP_PASS="replace_with_generated_app_password"
SMTP_FROM="replace_with_real@gmail.com"
SMTP_STARTTLS="1"                # 1 = upgrade to STARTTLS on port 587

# --- Sender addresses (Brevo transactional email) ----------------------------
# HOST channel (password reset / host login OTPs) — verified on the
# BREVO_HOST_API_KEY account.
MAIL_DEFAULT_SENDER="mdhaseebuddin77@gmail.com"

# STUDENT channel (student registration OTPs) — MUST be a sender verified on
# the BREVO_STUDENT_API_KEY_1/_2 accounts. Reusing the host sender here makes
# Brevo drop the emails (unverified sender / freemail-domain block).
MAIL_STUDENT_SENDER="velotest2026@gmail.com"

# --- Database ----------------------------------------------------------------
# Leave DATABASE_URL unset to use the default SQLite file at
# production_build/instance/exam.db (auto-created at startup).
# To use a hosted Postgres/MySQL DB, uncomment and set:
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"
# NOTE: this app ships SQLite/WAL-dialect SQL, so SQLite is the default and
# recommended engine.

# --- Optional tuning (safe to leave commented out; defaults listed) ----------
# DB_PATH                 # absolute path to the SQLite file (default: instance/exam.db)
# LOG_FILE                # absolute path to the log file (default: logs/exam.log)
# MAX_SUBMISSIONS=500     # hard cap on total completed exam submissions
# DAILY_REGISTRATION_LIMIT=70  # strict max student registrations per host per 24h (across all links)
# DAILY_REGISTRATION_WINDOW_HOURS=24  # rolling window (hours) that defines a host's "day"
# MAX_CONTENT_LENGTH=1048576   # max request-body bytes (1 MiB default)
# WTF_CSRF_TIME_LIMIT=21600    # CSRF-token lifetime in seconds (6 h default)


