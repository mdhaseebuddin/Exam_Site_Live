# =============================================================================
# Exam Platform — Production Environment Template
# =============================================================================
# COPY this file to `.env` in the production_build folder and fill in REAL
# values. NEVER commit the resulting `.env` (it is git-ignored). These are
# the ONLY environment variables the app needs at runtime.
#
# Generate a strong secret key:
#   python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================================

# --- Flask core -------------------------------------------------------------
FLASK_ENV="production"
SECRET_KEY="CHANGE_ME_generate_a_random_64_char_hex_key"
SESSION_COOKIE_SECURE="true"

# --- Email / SMTP (password-reset OTP delivery) ------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="replace_with_real@gmail.com"
SMTP_PASS="replace_with_generated_app_password"
SMTP_FROM="replace_with_real@gmail.com"
SMTP_STARTTLS="1"

